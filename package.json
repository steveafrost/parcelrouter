{
  "name": "parcelrouter",
  "version": "1.0.0",
  "description": "Local-first package tracking and delivery event routing from your inbox",
  "main": "dist/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "setup:check": "ts-node src/setup/preflight.ts",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "dotenv": "^18.0.5",
    "express": "^4.18.3",
    "imapflow": "^1.3.3",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/better-sqlite3": "^7.6.9",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.24",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "glob": "13.0.6",
    "minimatch": "10.2.6",
    "test-exclude": "8.0.0"
  }
}
