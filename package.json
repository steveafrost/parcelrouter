{
  "name": "parcelrouter",
  "version": "1.0.0",
  "description": "Local-first package tracking and delivery event routing from your inbox",
  "main": "dist/index.js",
  "engines": {
    "node": "25.x"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "setup:check": "ts-node src/setup/preflight.ts",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "imapflow": "^2.10.0",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/better-sqlite3": "^7.6.9",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "glob": "13.0.6",
    "minimatch": "10.2.6",
    "test-exclude": "8.0.0"
  }
}
